{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1440px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "canvas", "name": "NICE warm white", "color": "#FAF9F5" },
        { "slug": "ink", "name": "NICE black", "color": "#141413" },
        { "slug": "red", "name": "NICE red", "color": "#EF233C" },
        { "slug": "surface", "name": "Secondary surface", "color": "#F0EEE6" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "display", "name": "Montserrat", "fontFamily": "Montserrat, Arial, sans-serif" },
        { "slug": "body", "name": "Cabin", "fontFamily": "Cabin, Arial, sans-serif" },
        { "slug": "label", "name": "Roboto Condensed", "fontFamily": "'Roboto Condensed', Arial, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "body", "name": "Body", "size": "18px" },
        { "slug": "section", "name": "Section", "size": "48px" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|canvas", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "18px", "lineHeight": "1.55" },
    "spacing": { "blockGap": "0" }
  }
}
